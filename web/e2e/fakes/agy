#!/bin/sh
here=$(dirname "$0")
case "$1" in
  --version) echo "1.9.9"; exit 0;;
esac
prompt=""
while [ $# -gt 0 ]; do
  if [ "$1" = "-p" ]; then prompt="$2"; fi
  shift
done
AGENT=google PROMPT="$prompt"
. "$here/body.sh"
printf '{"conversation_id":"c1","status":"SUCCESS","response":"%s"}\n' "$BODY"
