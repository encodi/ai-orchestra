{
  "name": "ai-orchestra-web",
  "private": true,
  "license": "MIT OR Apache-2.0",
  "author": "Enrique C.",
  "version": "0.9.1",
  "type": "module",
  "description": "The local web interface of AI Orchestra. Built once; the compiled files are embedded in the Rust binary.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src tests e2e --max-warnings 0",
    "test": "vitest run",
    "e2e": "playwright test"
  },
  "dependencies": {
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^9.30.0",
    "@playwright/test": "^1.53.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^26.6.5",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^9.30.0",
    "eslint-plugin-react-hooks": "^6.1.1",
    "globals": "^17.13.0",
    "jsdom": "^30.1.2",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.35.0",
    "vite": "^8.3.4",
    "vitest": "^4.1.11"
  }
}
